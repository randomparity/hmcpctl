# Copy this file to .env and replace every value for the test environment.
# The values below are fictional samples. Do not use them against a live HMC.
# LIVE_TEST_* values are required by scripts/live_test_runner.py and are read
# only from this local file; exported LIVE_TEST_* variables are ignored.

# Managed system and LPARs used by the live scenarios (non-empty names).
LIVE_TEST_SYSTEM_NAME=example-lt-609-system
LIVE_TEST_LPAR_NAME=example-lt-609-lpar
LIVE_TEST_SCRATCH_LPAR_NAME=example-lt-609-scratch

# Test account and virtual disk names (non-empty names).
LIVE_TEST_VDISK_NAME=lt609-disk
LIVE_TEST_VDISK_VOLUME_GROUP_NAME=example-lt-609-vg

# Optional ST42: both settings enable one operator-released physical volume.
# Choose an absent hpvg<8 lowercase hex> group for this one authorized run.
# Missing/invalid settings SKIP; no disk is selected automatically.
# LIVE_TEST_SCRATCH_PV_NAME=
# LIVE_TEST_SCRATCH_VG_NAME=

# Optional ST43 diagnostic: 16 hex digits (default) gives a 34-character name;
# 12 gives a 30-character name with the same prefix. Separate live approval required.
#LIVE_TEST_PROFILE_ARTIFACT_SUFFIX_HEX_LENGTH=16

# Scratch LPAR create and modify resource limits in MiB, virtual CPUs and
# shared processing units. The units must suit the platform's per-processor
# minimum for the vCPU counts; 0.1 units per virtual processor is shown here.
LIVE_TEST_SCRATCH_CREATE_DESIRED_MEMORY_MIB=1536
LIVE_TEST_SCRATCH_CREATE_MAX_MEMORY_MIB=3072
LIVE_TEST_SCRATCH_CREATE_DESIRED_VCPUS=3
LIVE_TEST_SCRATCH_CREATE_MAX_VCPUS=6
LIVE_TEST_SCRATCH_CREATE_DESIRED_PROCS=0.3
LIVE_TEST_SCRATCH_CREATE_MAX_PROCS=0.6
LIVE_TEST_SCRATCH_MODIFY_DESIRED_MEMORY_MIB=2304
LIVE_TEST_SCRATCH_MODIFY_MAX_MEMORY_MIB=4608

# Dry-run provisioning target.
LIVE_TEST_DRY_RUN_LPAR_NAME=example-lt-609-dry-run
LIVE_TEST_DRY_RUN_STORAGE_NAME=example-lt-609-dry-disk
LIVE_TEST_DRY_RUN_MEMORY_MIB=1536

# Live provisioning fallback resources in MiB and virtual CPUs.
LIVE_TEST_PROVISION_MIN_MEMORY_MIB=1536
LIVE_TEST_PROVISION_DESIRED_MEMORY_MIB=3072
LIVE_TEST_PROVISION_MAX_MEMORY_MIB=6144
LIVE_TEST_PROVISION_DESIRED_VCPUS=3
LIVE_TEST_PROVISION_MAX_VCPUS=6

# VLAN for the partition ST13 and ST14 provision; it must already have a virtual
# network on LIVE_TEST_SYSTEM_NAME (the preflight checks). ST14's test-disk size in
# MiB, a multiple of 1024 (the HMC takes whole GiB).
LIVE_TEST_PROVISION_VLAN_ID=1
LIVE_TEST_PROVISION_DISK_MIB=10240

# Comma-separated LPAR names that ST20 must never mutate.
LIVE_TEST_PROTECTED_LPAR_NAMES=example-lt-609-protected-a,example-lt-609-protected-b

# SR-IOV adapter, physical port, logical port, capacity percentage, and profile.
# The logical port id may be lowercase hexadecimal, as the HMC reports it (e.g. 2700400a).
# The capacity must be a multiple of the physical port's min_eth_capacity_granularity.
LIVE_TEST_SRIOV_ADAPTER_ID=17
LIVE_TEST_SRIOV_PHYSICAL_PORT_ID=9
LIVE_TEST_SRIOV_LOGICAL_PORT_ID=917003
LIVE_TEST_SRIOV_CAPACITY_PERCENT=2.0
LIVE_TEST_SRIOV_PROFILE_NAME=example-lt-609-profile

# Dedicated PCIe arm (ST29-ST34). Optional, and the only optional block here:
# the arm creates and deletes a partition on the system it names, so it has no
# default and SKIPs unless SYSTEM_NAME and LPAR_PREFIX are both set. Leave them
# commented out unless you intend to run it.
#LIVE_TEST_DEDICATED_PCIE_SYSTEM_NAME=example-lt-609-system
#LIVE_TEST_DEDICATED_PCIE_LPAR_PREFIX=example-lt-609-pcie
#LIVE_TEST_DEDICATED_PCIE_PROFILE_NAME=default_profile
#LIVE_TEST_DEDICATED_PCIE_DRC_INDEX=21010020

# Bare-CEC arm (row 35). It reads the four dedicated PCIe keys above and also
# needs HMC_AUTHORIZE_POWER_OPERATIONS=true. It activates the partition it
# creates; set this to true only to let it take a platform dump (dumprestart).
# Unset or false skips that step; any other value skips the arm.
#LIVE_TEST_ACCEPT_PLATFORM_DUMP=false

# Virtual-media ISO path, HMC media name, HTTP listener, and HMC-visible host.
LIVE_TEST_ISO_PATH=/srv/example-lt-609/example-lt-609.iso
LIVE_TEST_ISO_MEDIA_NAME=example-lt-609.iso
LIVE_TEST_ISO_BIND_HOST=0.0.0.0
LIVE_TEST_ISO_ADVERTISED_HOST=iso.example.test
LIVE_TEST_ISO_HTTP_PORT=18090
# Media-repository sizes in MiB; each must be a multiple of 1024 (the HMC takes whole GiB).
LIVE_TEST_VMEDIA_REPOSITORY_SIZE_MIB=6144
LIVE_TEST_VMEDIA_SHORT_REPOSITORY_SIZE_MIB=1024

# Placement probe memory in MiB and inclusive VLAN range for a temporary network.
LIVE_TEST_PLACEMENT_MEMORY_MIB=3072
LIVE_TEST_VLAN_RANGE_START=3100
LIVE_TEST_VLAN_RANGE_END=3199

# The environment a live observation was made in, recorded with it. Both or
# neither: a lone key is a configuration error. Set the hardware family to the
# family of the system under test; the value below is only a placeholder. The
# release carries its maintenance level (V<n>R<n>M<n>); a bare V10R3 is rejected.
LIVE_TEST_ENV_HMC_RELEASE=V10R3M1060
LIVE_TEST_ENV_HARDWARE_FAMILY=POWER9

# Opt-in disposable saved-profile contract experiment: private packet and its exact SHA256.
# Both are required; see docs/live-testing.md. The packet does not authorize other arms.
# LIVE_TEST_PARTITION_PROFILE_CONTRACT_PACKET=/private/window/packet.json
# LIVE_TEST_PARTITION_PROFILE_CONTRACT_SHA256=<64-hex-sha256>
